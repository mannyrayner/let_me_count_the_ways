# Canonical texts are byte-faithful and retain source line endings.
corpus/works/*/canonical.txt -text whitespace=-trailing-space,-blank-at-eof,cr-at-eol
# Preserve the extension's downloaded source bytes across Windows/Cygwin checkouts.
data/raw/benedictsson-pengar/** -text whitespace=-trailing-space,-blank-at-eof,cr-at-eol
data/raw/skram-constance-ring/** -text whitespace=-trailing-space,-blank-at-eof,cr-at-eol
data/raw/gissing-the-odd-women/** -text whitespace=-trailing-space,-blank-at-eof,cr-at-eol
data/raw/von-arnim-vera/** -text whitespace=-trailing-space,-blank-at-eof,cr-at-eol
data/raw/skram-lucie/** -text whitespace=-trailing-space,-blank-at-eof,cr-at-eol

# Preserve the context extension source downloads byte-for-byte.
data/raw/tolstoy-war-and-peace/** -text whitespace=-trailing-space,-blank-at-eof,cr-at-eol
data/raw/shakespeare-king-lear/** -text whitespace=-trailing-space,-blank-at-eof,cr-at-eol

# Reproducible generated readers and context plans on Windows/Cygwin.
data/reader/** text eol=lf
scripts/reader/** text eol=lf
docs/reader/** text eol=lf
data/context_pilot/** text eol=lf
prompts/context_pilot/** text eol=lf
results/context_pilot/** text eol=lf
data/acquisition/context_extension_3_v1/** text eol=lf
provenance/sources/*-context-v1.json text eol=lf
corpus/works/tolstoy-war-and-peace/work.json text eol=lf
corpus/works/shakespeare-king-lear/work.json text eol=lf
corpus/works/saint-exupery-le-petit-prince/work.json text eol=lf

# Quoted source whitespace is evidence, including in generated reading copies.
docs/reader/** whitespace=-trailing-space,-blank-at-eof
results/context_pilot/**/*.html whitespace=-trailing-space,-blank-at-eof
# Authorized publication copy retains the exact canonical source hash.
results/publication/petit_prince_v1/canonical.txt -text whitespace=-trailing-space,-blank-at-eof,cr-at-eol

# Keep new context-pilot artifacts byte-stable across Windows checkouts.
results/context_pilot/v2_dossier/** -text
results/context_pilot/v2_full_text/** -text

results/context_pilot/v3_dossier/** -text
results/context_pilot/v3_full_text/** -text
results/context_pilot/comparison_v2_v3/** -text
