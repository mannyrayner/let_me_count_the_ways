          "annotations": [],
          "logprobs": [],
          "text": "{\"occurrence_id\":\"bronte-jane-eyre-a880a1f99d9b190d\",\"core_classification\":{\"label_support\":{\"truth_conditional\":4,\"performative\":0,\"exclamatory_reflexive\":0,\"other\":0},\"confidence\":0.98,\"analysis\":\"The embedded “I loved you” represents a hypothetical, deceitful assertion that Jane had loving feelings for Mrs. Reed. Its represented force is truth-conditional even though Jane explicitly rejects its truth and does not independently utter it as an avowal. It undertakes no relational commitment and is not presented as affect-driven verbal discharge.\",\"ambiguity\":\"The phrase occurs inside Jane’s actual speech, but the love avowal itself is counterfactual rather than asserted; the actual higher-level act is a forceful denial of love and deceitfulness.\"},\"other_diagnosis\":{\"tpe_failure\":null,\"core_not_context\":null},\"utterance_status\":{\"status\":\"hypothetical\",\"description\":\"A counterfactual avowal embedded in Jane’s direct statement: she says that if she were deceitful, she would say “I loved you.”\"},\"contextual_interpretation\":\"Jane invokes the hypothetical avowal only to contrast it with her actual declaration that she does not love Mrs. Reed. The imagined assertion would be knowingly false and instrumental, while Jane’s surrounding speech presents her refusal to make it as proof of honesty amid resentment over Mrs. Reed’s cruelty and accusations. This deception-related framing affects sincerity and assertion status, not the T classification of the represented avowal.\",\"evidence\":[{\"evidence_id\":\"e1\",\"source\":\"local_text\",\"quotation_or_description\":\"“if I were, I should say I loved you”\",\"supports\":\"The conditional construction establishes that the love avowal is hypothetical and would be made under the counterfactual condition that Jane were deceitful.\",\"confidence\":0.99},{\"evidence_id\":\"e2\",\"source\":\"local_text\",\"quotation_or_description\":\"“but I declare I do not love you”\",\"supports\":\"Jane explicitly cancels any inference that the embedded avowal expresses her actual attitude; her real assertion is the opposite.\",\"confidence\":0.99},{\"evidence_id\":\"e3\",\"source\":\"local_text\",\"quotation_or_description\":\"Jane says she “must” speak, gathers her energies, and launches a blunt sentence amid intense resentment.\",\"supports\":\"The surrounding speech is emotionally forceful, but the narrative supplies no evidence that the embedded hypothetical words themselves function as an expressive/reflex-like discharge.\",\"confidence\":0.96},{\"evidence_id\":\"e4\",\"source\":\"supplied_metadata\",\"quotation_or_description\":\"The occurrence is identified as an emphasized, affirmative, past-tense explicit I–love–you construction in Chapter IV.\",\"supports\":\"Confirms the grammatical form of the embedded proposition while leaving its conditional scope to be determined from the passage.\",\"confidence\":0.98}],\"background_knowledge\":{\"used\":false,\"familiarity\":\"none\",\"confidence\":null,\"contribution\":null},\"ontology_assessment\":{\"fit\":\"natural\",\"diagnosis\":\"T naturally captures the represented assertion of a past loving state. Its hypothetical scope, intended falsity, and role in Jane’s actual denial are adequately recorded as contextual complications rather than missing dimensions of core force.\",\"candidate_recurrent_dimension\":null},\"notes\":null}"
        }
