          "annotations": [],
          "logprobs": [],
          "text": "{\"occurrence_id\":\"lawrence-women-in-love-86dea678c8044a4f\",\"core_classification\":{\"label_support\":{\"truth_conditional\":4,\"performative\":1,\"exclamatory_reflexive\":0,\"other\":0},\"confidence\":0.96,\"analysis\":\"The utterance is principally a direct avowal presenting the speaker's love as true. Its intimate placement during a kiss gives it slight relationally enactive force, but the text does not clearly establish a commitment or undertaking. The whispering, trembling, and intense hope characterize emotional delivery without showing that the words are a reflex-like discharge.\",\"ambiguity\":\"There is limited ambiguity about whether the declaration itself helps enact a relational commitment; the passage more clearly supports avowal than undertaking.\"},\"other_diagnosis\":{\"tpe_failure\":null,\"core_not_context\":null},\"utterance_status\":{\"status\":\"direct\",\"description\":\"Direct speech by the male character to the woman while he kisses her.\"},\"contextual_interpretation\":\"The declaration accompanies a kiss and is followed by trembling and imagery of rebirth, hope, and transcendence of death. This framing presents the avowal as sincere and emotionally transformative, but intensity and bodily reaction alone do not establish expressive/reflexive force or a definite commitment.\",\"evidence\":[{\"evidence_id\":\"e1\",\"source\":\"local_text\",\"quotation_or_description\":\"“I love you,” he whispered as he kissed her\",\"supports\":\"The explicit first-person declaration strongly supports truth-conditional avowal; the kiss provides weak support for relational enactment.\",\"confidence\":0.99},{\"evidence_id\":\"e2\",\"source\":\"local_text\",\"quotation_or_description\":\"“trembled with pure hope, like a man who is born again to a wonderful, lively hope”\",\"supports\":\"The narrator frames the moment as affectively intense and transformative, while supplying no specific evidence that the words were involuntarily blurted or otherwise functioned as expressive discharge.\",\"confidence\":0.95}],\"background_knowledge\":{\"used\":false,\"familiarity\":\"none\",\"confidence\":null,\"contribution\":null},\"ontology_assessment\":{\"fit\":\"natural\",\"diagnosis\":\"T/P/E adequately represents the core force: a strong avowal with at most slight undertaking force and no independently evidenced expressive/reflexive component. The remaining emotional and narrative richness belongs to context rather than an omitted core category.\",\"candidate_recurrent_dimension\":null},\"notes\":null}"
        }
