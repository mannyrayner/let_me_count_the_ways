          "annotations": [],
          "logprobs": [],
          "text": "{\"occurrence_id\":\"shakespeare-king-lear-1c492e4522915225\",\"core_classification\":{\"label_support\":{\"truth_conditional\":1,\"performative\":3,\"exclamatory_reflexive\":0,\"other\":0},\"confidence\":0.91,\"analysis\":\"Kent’s modal “I must love you” is primarily a courteous prospective undertaking to regard Edmund favorably and cultivate acquaintance. It weakly presents an affiliative disposition as true, but does not straightforwardly avow an already established loving emotion. Nothing indicates that the words are a reflex-like affective discharge.\",\"ambiguity\":\"“Must” can express both felt inevitability and social obligation; the immediate first-meeting context favors a conventional affiliative undertaking over a report of deep present feeling.\"},\"other_diagnosis\":{\"tpe_failure\":null,\"core_not_context\":null},\"utterance_status\":{\"status\":\"direct\",\"description\":\"Kent directly addresses Edmund upon being introduced to him for the first time.\"},\"contextual_interpretation\":\"Gloucester introduces Kent as an honorable friend and asks Edmund to remember him; Kent responds by undertaking to favor Edmund and seek closer acquaintance. Edmund’s promise to “study deserving” confirms that the exchange establishes prospective mutual regard within a formal courtly introduction. The utterance is courteous and potentially sincere, but not an impassioned declaration.\",\"evidence\":[{\"evidence_id\":\"e1\",\"source\":\"local_text\",\"quotation_or_description\":\"Gloucester tells Edmund: “My Lord of Kent: remember him hereafter as my honourable friend.”\",\"supports\":\"The utterance occurs within a formal introduction that invites a new affiliative relationship.\",\"confidence\":0.98},{\"evidence_id\":\"e2\",\"source\":\"local_text\",\"quotation_or_description\":\"Kent says, “I must love you, and sue to know you better.”\",\"supports\":\"The obligation modal and coordinated intention to pursue acquaintance support prospective relational undertaking force rather than a simple report of established emotion.\",\"confidence\":0.99},{\"evidence_id\":\"e3\",\"source\":\"local_text\",\"quotation_or_description\":\"Edmund replies, “Sir, I shall study deserving.”\",\"supports\":\"Edmund treats Kent’s words as offered future favor that he should endeavor to merit, reinforcing the performative reading.\",\"confidence\":0.96},{\"evidence_id\":\"e4\",\"source\":\"supplied_metadata\",\"quotation_or_description\":\"The form is identified as affirmative modal, under the pattern “en_obligation_modal_affirmative.”\",\"supports\":\"The grammatical form independently supports an obligation- or necessity-inflected interpretation.\",\"confidence\":0.95}],\"background_knowledge\":{\"used\":false,\"familiarity\":\"none\",\"confidence\":null,\"contribution\":null},\"ontology_assessment\":{\"fit\":\"natural\",\"diagnosis\":\"T and especially P adequately represent the core force: a weak avowal of favorable disposition combined with a substantial prospective undertaking of regard and acquaintance. Courtly conventionality is contextual and creates no residual ontology pressure.\",\"candidate_recurrent_dimension\":null},\"notes\":null}"
        }
