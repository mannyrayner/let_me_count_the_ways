          "annotations": [],
          "logprobs": [],
          "text": "{\"occurrence_id\":\"tolstoy-war-and-peace-1aa794a7bd4e9735\",\"core_classification\":{\"label_support\":{\"truth_conditional\":4,\"performative\":0,\"exclamatory_reflexive\":0,\"other\":0},\"confidence\":0.95,\"analysis\":\"The old countess directly presents her longstanding affection for Princess Marya as true: “je vous aime et vous connais depuis longtemps.” The embrace, kisses, and moved expression reinforce the avowal, but the words do not establish a commitment or relational undertaking. Nor is there positive evidence that they are a reflex-like affective discharge rather than a warmly delivered assertion and conventional welcome.\",\"ambiguity\":\"The greeting has a courteous, socially conventional quality, which may qualify the depth or spontaneity of the professed affection, but it does not alter its predominantly truth-conditional force.\"},\"other_diagnosis\":{\"tpe_failure\":null,\"core_not_context\":null},\"utterance_status\":{\"status\":\"direct\",\"description\":\"The old countess speaks the French love avowal directly to Princess Marya upon receiving her.\"},\"contextual_interpretation\":\"The countess welcomes Princess Marya as “my child,” embraces and kisses her, and professes both love and long familiarity. In the crisis surrounding Prince Andrei, the utterance offers warmth, acceptance, and reassurance. Princess Marya, preoccupied with her brother, experiences the exchange partly as required courtesy and answers in the same polite tone; this framing may suggest conventionality but not a distinct performative undertaking or expressive/reflexive core force.\",\"evidence\":[{\"evidence_id\":\"e1\",\"source\":\"local_text\",\"quotation_or_description\":\"“Mon enfant! … je vous aime et vous connais depuis longtemps.”\",\"supports\":\"The explicit present-tense avowal, coordinated with a claim of longstanding knowledge, strongly supports truth-conditional presentation of affection.\",\"confidence\":0.99},{\"evidence_id\":\"e2\",\"source\":\"local_text\",\"quotation_or_description\":\"The old countess approaches with a moved expression, embraces Princess Marya, and begins kissing her before speaking.\",\"supports\":\"The countess’s affectionate conduct corroborates the avowal and its warm delivery, while not independently establishing expressive/reflexive force.\",\"confidence\":0.96},{\"evidence_id\":\"e3\",\"source\":\"local_text\",\"quotation_or_description\":\"Princess Marya replies with “some courteous French words, in the same tone” as those spoken to her.\",\"supports\":\"This indicates a socially courteous greeting register and explains the limited ambiguity about conventionality or depth of feeling.\",\"confidence\":0.94},{\"evidence_id\":\"e4\",\"source\":\"supplied_metadata\",\"quotation_or_description\":\"The occurrence is identified as an affirmative present-tense explicit love expression, with exact match “je vous aime.”\",\"supports\":\"Confirms that the classified core is a direct affirmative love avowal rather than a negated or hypothetical construction.\",\"confidence\":0.99}],\"background_knowledge\":{\"used\":false,\"familiarity\":\"none\",\"confidence\":null,\"contribution\":null},\"ontology_assessment\":{\"fit\":\"natural\",\"diagnosis\":\"T naturally captures the core avowal. Its warmth, conventional courtesy, and reassuring social role are adequately represented as context and delivery; they create no residual pressure for P, E, or O.\",\"candidate_recurrent_dimension\":null},\"notes\":null}"
        }
