          "annotations": [],
          "logprobs": [],
          "text": "{\"occurrence_id\":\"bronte-tenant-of-wildfell-hall-71677da4941ea07e\",\"core_classification\":{\"label_support\":{\"truth_conditional\":4,\"performative\":0,\"exclamatory_reflexive\":0,\"other\":0},\"confidence\":0.96,\"analysis\":\"Gilbert directly avows that his love for Helen is stronger than ever, using that asserted emotional state to protest her demand that they never meet again. The utterance does not itself undertake a commitment, and its emotional intensity supplies no independent evidence of expressive/reflexive discharge.\",\"ambiguity\":\"The utterance pragmatically argues against separation and implies a desire to continue the relationship, but this is not enough to establish performative undertaking force.\"},\"other_diagnosis\":{\"tpe_failure\":null,\"core_not_context\":null},\"utterance_status\":{\"status\":\"direct\",\"description\":\"Gilbert directly addresses Helen in spoken dialogue: “Never again, Helen? just when I love you more than ever.”\"},\"contextual_interpretation\":\"The avowal answers Helen’s insistence that he must never return. Gilbert presents his intensified love as a reason that permanent separation is especially unbearable and later characterises separation as a matter of “life and death.” Helen’s existing marital and moral obligations make the avowal part of a painful conflict between passion and duty, but that conflict does not alter its predominantly truth-conditional force.\",\"evidence\":[{\"evidence_id\":\"e1\",\"source\":\"local_text\",\"quotation_or_description\":\"“Never again, Helen? just when I love you more than ever.”\",\"supports\":\"The comparative phrase “more than ever” explicitly presents Gilbert’s current loving emotional state as true, strongly supporting T.\",\"confidence\":0.99},{\"evidence_id\":\"e2\",\"source\":\"local_text\",\"quotation_or_description\":\"Helen has just told Gilbert that he must leave and “never come again.”\",\"supports\":\"The utterance functions as an incredulous protest and offers his love as a reason against separation; this explains its conversational purpose without making it a commitment-performing act.\",\"confidence\":0.98},{\"evidence_id\":\"e3\",\"source\":\"local_text\",\"quotation_or_description\":\"Gilbert later says he cannot discuss eternal separation dispassionately and calls it “a question of life and death.”\",\"supports\":\"The surrounding intensity corroborates the depth of the avowed feeling, but does not independently establish expressive/reflexive core force.\",\"confidence\":0.96},{\"evidence_id\":\"e4\",\"source\":\"local_text\",\"quotation_or_description\":\"The narration presents a sustained conversation in which Gilbert responds coherently to Helen’s reasons and requests.\",\"supports\":\"The words are a deliberate, contextually integrated avowal rather than a reflex-like verbal discharge or semantically ungrounded token.\",\"confidence\":0.94}],\"background_knowledge\":{\"used\":false,\"familiarity\":\"none\",\"confidence\":null,\"contribution\":null},\"ontology_assessment\":{\"fit\":\"natural\",\"diagnosis\":\"T naturally captures the core avowal. Its protest function, emotional intensity, and role in the conflict over separation are adequately represented as context rather than additional core force.\",\"candidate_recurrent_dimension\":null},\"notes\":null}"
        }
