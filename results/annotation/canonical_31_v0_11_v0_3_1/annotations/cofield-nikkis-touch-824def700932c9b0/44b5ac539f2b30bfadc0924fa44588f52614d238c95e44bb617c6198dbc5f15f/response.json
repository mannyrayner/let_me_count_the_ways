          "annotations": [],
          "logprobs": [],
          "text": "{\"occurrence_id\":\"cofield-nikkis-touch-824def700932c9b0\",\"core_classification\":{\"label_support\":{\"truth_conditional\":4,\"performative\":1,\"exclamatory_reflexive\":0,\"other\":0},\"confidence\":0.97,\"analysis\":\"Franco’s “I’ve loved you for a while now” is principally a considered avowal that his love has existed over an extended period. It carries weak relational-commitment implications as a consequential romantic disclosure, but it does not explicitly undertake an obligation or promise. His prior deliberation and steady delivery weigh against expressive/reflexive force.\",\"ambiguity\":\"The wedding setting and significance of the disclosure give marginal support to P, though the words remain primarily an avowal rather than a commitment.\"},\"other_diagnosis\":{\"tpe_failure\":null,\"core_not_context\":null},\"utterance_status\":{\"status\":\"direct\",\"description\":\"Franco directly tells Nikki, “I’ve loved you for a while now,” immediately after saying “I love you, Nikki.”\"},\"contextual_interpretation\":\"Franco presents the declaration as sincere, epistemically settled, and deliberately timed: he waited to avoid rushing and now knows the love is real. The surrounding wedding and Nikki’s reciprocal declaration heighten its relational importance, but the highlighted clause chiefly asserts a continuing emotional state. Emotional intensity is contextual and does not independently establish E.\",\"evidence\":[{\"evidence_id\":\"e1\",\"source\":\"local_text\",\"quotation_or_description\":\"“I’ve loved you for a while now.”\",\"supports\":\"Strong T: Franco explicitly presents his loving state as having persisted over time.\",\"confidence\":0.99},{\"evidence_id\":\"e2\",\"source\":\"local_text\",\"quotation_or_description\":\"“I needed to make sure I didn’t rush this. But now... I know. I know it’s real.”\",\"supports\":\"The declaration is reflective and considered rather than a reflex-like expressive discharge, supporting E=0.\",\"confidence\":0.98},{\"evidence_id\":\"e3\",\"source\":\"local_text\",\"quotation_or_description\":\"His voice is described as “steady and sincere” while he makes the declaration.\",\"supports\":\"Supports a deliberate, sincere avowal and provides no independent evidence for expressive/reflexive force.\",\"confidence\":0.96},{\"evidence_id\":\"e4\",\"source\":\"local_text\",\"quotation_or_description\":\"The declaration occurs while Franco and Nikki watch a wedding ceremony, and Nikki answers, “I love you too, Franco.”\",\"supports\":\"The relational setting and reciprocal response provide weak pragmatic support for P without establishing an explicit undertaking.\",\"confidence\":0.9},{\"evidence_id\":\"e5\",\"source\":\"supplied_metadata\",\"quotation_or_description\":\"The highlighted form is identified as affirmative perfect aspect.\",\"supports\":\"Consistent with the utterance presenting love as a state extending from the past into the relevant present.\",\"confidence\":0.99}],\"background_knowledge\":{\"used\":false,\"familiarity\":\"none\",\"confidence\":null,\"contribution\":null},\"ontology_assessment\":{\"fit\":\"natural\",\"diagnosis\":\"T naturally captures the sustained-state avowal, with slight P support for its relational significance. Contextual emotion and deliberation require neither E nor O.\",\"candidate_recurrent_dimension\":null},\"notes\":null}"
        }
