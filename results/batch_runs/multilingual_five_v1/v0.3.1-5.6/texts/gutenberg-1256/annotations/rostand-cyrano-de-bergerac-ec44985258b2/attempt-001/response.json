          "annotations": [],
          "logprobs": [],
          "text": "{\"occurrence_id\":\"rostand-cyrano-de-bergerac-ec44985258b2\",\"core_classification\":{\"label_support\":{\"truth_conditional\":4,\"performative\":0,\"exclamatory_reflexive\":0,\"other\":0},\"confidence\":0.96,\"analysis\":\"The represented “Je t'aime !” is a conventional avowal that presents the speaker's love for the prince as true. The passage supplies no undertaking or obligation beyond that avowal, and its exclamation mark and transformative emotional effect do not independently establish expressive/reflexive force.\",\"ambiguity\":\"The fairy-tale declaration may carry a weak relational or courtship implication, but nothing in the excerpt establishes commitment-level performative force.\"},\"other_diagnosis\":{\"tpe_failure\":null,\"core_not_context\":null},\"utterance_status\":{\"status\":\"hypothetical\",\"description\":\"Cyrano cites a generic utterance within a fairy-tale scenario—“lorsqu'on dit: Je t'aime !”—rather than directly saying it to his present interlocutor.\"},\"contextual_interpretation\":\"Cyrano invokes the declaration as part of a fairy-tale convention in which words of love make a shame-filled prince's ugliness disappear, then contrasts that magical result with his own unchanged appearance. This framing makes the occurrence hypothetical and metanarrative, but the represented declaration itself remains a truth-conditional avowal of love.\",\"evidence\":[{\"evidence_id\":\"ev1\",\"source\":\"local_text\",\"quotation_or_description\":\"“c'est dans le conte / Que lorsqu'on dit: Je t'aime !”\",\"supports\":\"The conditional-generic construction and explicit reference to a tale establish that the occurrence is a hypothetical, cited declaration.\",\"confidence\":0.99},{\"evidence_id\":\"ev2\",\"source\":\"local_text\",\"quotation_or_description\":\"“au prince plein de honte”\",\"supports\":\"The represented words are addressed to a prince within the tale, supporting interpretation as an interpersonal avowal rather than Cyrano's direct present speech.\",\"confidence\":0.98},{\"evidence_id\":\"ev3\",\"source\":\"local_text\",\"quotation_or_description\":\"“Il sent sa laideur fondre à ces mots de soleil. . . / Mais tu t'apercevrais que je reste pareil.”\",\"supports\":\"Cyrano contrasts the imagined transformative effect of the love words with reality; this supplies narrative framing but no independent evidence for performative or reflexive force in the core utterance.\",\"confidence\":0.97}],\"background_knowledge\":{\"used\":false,\"familiarity\":\"none\",\"confidence\":null,\"contribution\":null},\"ontology_assessment\":{\"fit\":\"natural\",\"diagnosis\":\"T naturally captures the represented declaration as an avowal. Its hypothetical quotation and fairy-tale framing are adequately recorded as utterance status and context; they create no residual core-force pressure requiring O.\",\"candidate_recurrent_dimension\":null},\"notes\":null}"
        }
