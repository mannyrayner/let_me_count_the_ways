          "text": "{\"occurrence_id\":\"cofield-nikkis-touch-fe0a036beb97\",\"core_classification\":{\"label_support\":{\"truth_conditional\":4,\"performative\":0,\"exclamatory_reflexive\":0,\"other\":0},\"confidence\":0.94,\"analysis\":\"The speaker directly and reciprocally avows love for Franco. The emotional delivery reinforces the sincerity and intensity of the avowal but does not independently establish either a relational undertaking or reflex-like expressive force.\",\"ambiguity\":\"The narrow excerpt cannot establish sincerity with certainty, but sincerity is not required for the strongly truth-conditional force.\"},\"other_diagnosis\":{\"tpe_failure\":null,\"core_not_context\":null},\"utterance_status\":{\"status\":\"direct\",\"description\":\"A character directly addresses Franco with the spoken utterance “I love you too, Franco.”\"},\"contextual_interpretation\":\"“Too” presents the declaration as a reciprocal response to an earlier or understood expression of love. Her emotion-thickened voice and gladness at having found Franco frame it as an affectively intense avowal. Those delivery cues do not by themselves make the words an expressive/reflexive discharge, and the excerpt contains no explicit commitment or undertaking.\",\"evidence\":[{\"evidence_id\":\"e1\",\"source\":\"local_text\",\"quotation_or_description\":\"“I love you too, Franco,”\",\"supports\":\"The literal first-person declaration, direct address, and reciprocal “too” strongly support truth-conditional avowal.\",\"confidence\":0.99},{\"evidence_id\":\"e2\",\"source\":\"local_text\",\"quotation_or_description\":\"“she said, her voice thick with emotion”\",\"supports\":\"This establishes emotionally intense delivery, but supplies no independent evidence that the words are a reflex-like discharge rather than an emotional avowal.\",\"confidence\":0.96},{\"evidence_id\":\"e3\",\"source\":\"local_text\",\"quotation_or_description\":\"“I’m so glad I found you.”\",\"supports\":\"The follow-up conveys positive relational valuation and supports the affectionate context, without explicitly undertaking an obligation or commitment.\",\"confidence\":0.93}],\"background_knowledge\":{\"used\":false,\"familiarity\":\"none\",\"confidence\":null,\"contribution\":null},\"ontology_assessment\":{\"fit\":\"natural\",\"diagnosis\":\"T naturally captures the reciprocal avowal. Emotional intensity can remain contextual because nothing important about the utterance’s core force requires P, E, or O.\",\"candidate_recurrent_dimension\":null},\"notes\":null}"
        }
