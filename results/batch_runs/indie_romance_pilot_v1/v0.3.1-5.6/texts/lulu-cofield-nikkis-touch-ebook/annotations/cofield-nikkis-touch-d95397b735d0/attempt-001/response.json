          "annotations": [],
          "logprobs": [],
          "text": "{\"occurrence_id\":\"cofield-nikkis-touch-d95397b735d0\",\"core_classification\":{\"label_support\":{\"truth_conditional\":4,\"performative\":0,\"exclamatory_reflexive\":4,\"other\":0},\"confidence\":0.98,\"analysis\":\"Nikki directly avows a loving emotional state, strongly supporting T. The narration also explicitly presents the words as an involuntary affective discharge—said suddenly and “spilling out before she could stop them”—which independently gives strong support to E. Nothing in the excerpt indicates that the utterance undertakes or renews a commitment, so P is unsupported.\",\"ambiguity\":\"The intimate setting may give the avowal relational significance, but it does not independently establish performative commitment.\"},\"other_diagnosis\":{\"tpe_failure\":null,\"core_not_context\":null},\"utterance_status\":{\"status\":\"direct\",\"description\":\"Nikki directly says “I love you” to Keith while they are lying together in bed.\"},\"contextual_interpretation\":\"The post-intimacy setting and Nikki’s “heart full” frame the utterance as a sincere-seeming avowal. More decisively for E, the narration depicts its production as sudden and difficult to inhibit: the words emerge before she can stop them. This is positive evidence of reflex-like expressive force rather than mere passionate delivery. No promise, obligation, or relational undertaking is stated or invoked.\" ,\"evidence\":[{\"evidence_id\":\"e1\",\"source\":\"local_text\",\"quotation_or_description\":\"“She turned to him, her heart full. ‘I love you,’”\",\"supports\":\"The description of Nikki’s affective state and her direct address strongly support a truth-conditional avowal of love.\",\"confidence\":0.98},{\"evidence_id\":\"e2\",\"source\":\"local_text\",\"quotation_or_description\":\"“she said suddenly, the words spilling out before she could stop them”\",\"supports\":\"This explicitly characterizes the utterance as an unplanned, difficult-to-inhibit expressive discharge, independently supporting E.\",\"confidence\":0.99},{\"evidence_id\":\"e3\",\"source\":\"local_text\",\"quotation_or_description\":\"“As they lay in bed afterward, Keith traced lazy circles on Nikki’s arm.”\",\"supports\":\"The intimate interpersonal setting supports an affectionate reading, while supplying no clear evidence of a commitment or undertaking.\",\"confidence\":0.93}],\"background_knowledge\":{\"used\":false,\"familiarity\":\"none\",\"confidence\":null,\"contribution\":null},\"ontology_assessment\":{\"fit\":\"natural\",\"diagnosis\":\"T and E naturally capture the utterance’s dual force as both an avowal of love and an affect-driven verbal discharge. Contextual intimacy is adequately handled as evidence and does not require O.\",\"candidate_recurrent_dimension\":null},\"notes\":null}"
        }
