          "text": "{\"target_identification\":{\"speaker\":null,\"addressee\":null,\"anchor_quote\":\"je t'aime\"},\"target_translation\":\"I love you.\",\"dimensions\":{\"T\":{\"score\":4,\"evidence_status\":\"assessable\",\"confidence\":0.99,\"reason\":\"In its ordinary declarative form, the expression directly presents the speaker's loving emotional state toward the addressee as true.\",\"evidence\":[{\"block_id\":\"target\",\"quotation\":\"je t'aime\"}]},\"P\":{\"score\":0,\"evidence_status\":\"assessable\",\"confidence\":0.78,\"reason\":\"The expression lexically avows love but, without any represented context linking it to a bond, obligation, or undertaking, it does not itself establish commitment force.\",\"evidence\":[{\"block_id\":\"target\",\"quotation\":\"je t'aime\"}]},\"E\":{\"score\":0,\"evidence_status\":\"assessable\",\"confidence\":0.75,\"reason\":\"The bare declarative supplies no linguistic evidence of a reflex-like affective discharge beyond the avowal itself.\",\"evidence\":[{\"block_id\":\"target\",\"quotation\":\"je t'aime\"}]},\"O\":{\"score\":0,\"evidence_status\":\"assessable\",\"confidence\":0.84,\"reason\":\"No core function beyond the truth-presenting avowal is supported by the isolated expression.\",\"evidence\":[{\"block_id\":\"target\",\"quotation\":\"je t'aime\"}]}},\"original_speech_situation\":\"No original speech situation is supplied; only an isolated French expression is available.\",\"affection_evidence\":\"unknown\",\"undertaking_and_uptake\":\"No undertaking or obligation is established by the supplied expression alone, and no evidence of addressee uptake is available.\",\"recognised_work\":false,\"recognition_note\":\"The isolated expression does not identify a particular work.\",\"limitations\":\"With no source blocks, speaker, addressee, delivery, surrounding discourse, sincerity, relationship history, contextual commitment force, and uptake cannot be determined. The T score concerns the expression's avowal mode, not whether the speaker actually feels love.\"}"
