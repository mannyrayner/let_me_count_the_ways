          "text": "{\n  \"target_identification\": {\n    \"speaker\": \"Pierre\",\n    \"addressee\": \"Hélène\",\n    \"anchor_quote\": \"Je vous aime!\"\n  },\n  \"target_translation\": \"I love you.\",\n  \"dimensions\": {\n    \"T\": {\n      \"score\": 4,\n      \"evidence_status\": \"assessable\",\n      \"confidence\": 0.98,\n      \"reason\": \"This is a direct, present-tense avowal of love. Its truth-presenting force remains clear even though Pierre delivers it as an expected formula and feels dissatisfied with how it sounds.\",\n      \"evidence\": [\n        {\n          \"block_id\": \"target\",\n          \"quotation\": \"Je vous aime\"\n        },\n        {\n          \"block_id\": \"scene\",\n          \"quotation\": \"«Теперь уж поздно, всё кончено; да и я люблю ее», подумал Пьер.\"\n        }\n      ]\n    },\n    \"P\": {\n      \"score\": 0,\n      \"evidence_status\": \"assessable\",\n      \"confidence\": 0.94,\n      \"reason\": \"The focal words state a present feeling but do not themselves promise marriage, fidelity, future conduct, or any other obligation. The surrounding recognition of an engagement must not be transferred onto this avowal.\",\n      \"evidence\": [\n        {\n          \"block_id\": \"target\",\n          \"quotation\": \"Je vous aime\"\n        },\n        {\n          \"block_id\": \"scene\",\n          \"quotation\": \"Пьер молча держал руку своей невесты и смотрел на ее поднимающуюся и опускающуюся прекрасную грудь.\"\n        }\n      ]\n    },\n    \"E\": {\n      \"score\": 0,\n      \"evidence_status\": \"assessable\",\n      \"confidence\": 0.97,\n      \"reason\": \"The expression is not represented as a spontaneous or reflex-like discharge of affect. Pierre pauses, deliberately recalls what convention requires, and then says it.\",\n      \"evidence\": [\n        {\n          \"block_id\": \"scene\",\n          \"quotation\": \"сказал он, вспомнив то, чтó нужно было говорить в этих случаях; но слова эти прозвучали так бедно, что ему стало стыдно за себя.\"\n        }\n      ]\n    },\n    \"O\": {\n      \"score\": 0,\n      \"evidence_status\": \"assessable\",\n      \"confidence\": 0.87,\n      \"reason\": \"The utterance has a secondary socially scripted role, but its core force is adequately captured as an avowal under T. The evidence does not establish a separate core function such as a question, command, wish, or ceremonial act.\",\n      \"evidence\": [\n        {\n          \"block_id\": \"target\",\n          \"quotation\": \"Je vous aime\"\n        },\n        {\n          \"block_id\": \"scene\",\n          \"quotation\": \"вспомнив то, чтó нужно было говорить в этих случаях\"\n        }\n      ]\n    }\n  },\n  \"original_speech_situation\": \"After Hélène's family has already treated the pair as engaged and Hélène has kissed him, Pierre is alone with her and feels that the situation is settled. He pauses, remembers the conventional words expected on such an occasion, and makes the focal declaration directly to her.\",\n  \"affection_evidence\": \"mixed\",\n  \"undertaking_and_uptake\": \"The focal expression makes no explicit undertaking. The surrounding scene treats Pierre and Hélène as already engaged, but that relational status is not created by the words “Je vous aime.” Hélène gives no recorded verbal response to this particular declaration; the later marriage shows the broader match proceeded, not the specific uptake of the avowal.\",\n  \"recognised_work\": true,\n  \"recognition_note\": \"Recognised as Leo Tolstoy's War and Peace.\",\n  \"limitations\": \"The supplied scene supports attraction and Pierre's internal claim that he loves Hélène, while also emphasizing social pressure, hesitation, shame, and formulaic delivery. It therefore does not conclusively settle the sincerity, depth, or character of his affection, nor Hélène's specific interpretation of the focal words.\"\n}"
