          "text": "{\n  \"occurrence_id\": \"bronte-jane-eyre-d0cd60fde247\",\n  \"label_support\": {\n    \"truth_conditional\": 4,\n    \"performative\": 1,\n    \"exclamatory_reflexive\": 1\n  },\n  \"construals\": [\n    {\n      \"perspective\": \"speaker\",\n      \"analysis\": \"The speaker avows an existing emotional state and presents that love as the reason for speaking honestly rather than flattering the hearer.\"\n    },\n    {\n      \"perspective\": \"hearer\",\n      \"analysis\": \"The passage does not provide the hearer's response, but the avowal could function as reassurance that the surrounding criticism of his appearance does not imply lack of affection.\"\n    },\n    {\n      \"perspective\": \"narrator_or_text\",\n      \"analysis\": \"The concessive construction contrasts sincere love with refusal to idealize or flatter: loving the hearer and judging him not handsome are presented as compatible.\"\n    },\n    {\n      \"perspective\": \"reader\",\n      \"analysis\": \"A reader is strongly licensed to take the clause as a sincere factual avowal, intensified by 'most dearly' and corroborated by the claim that such love requires honesty.\"\n    }\n  ],\n  \"features\": [\n    \"mixed_reading\"\n  ],\n  \"evidence\": [\n    {\n      \"text\": \"though I love you most dearly\",\n      \"supports\": \"The syntactically integrated concessive clause straightforwardly asserts a present loving state; 'most dearly' intensifies that avowal.\"\n    },\n    {\n      \"text\": \"far too dearly to flatter you\",\n      \"supports\": \"The speaker treats love as a motive for candour, reinforcing the truth-conditional reading and presenting the avowal as sincere rather than formulaic.\"\n    },\n    {\n      \"text\": \"I don’t call you handsome, sir\",\n      \"supports\": \"The contrast shows that the love claim reassures the hearer while refusing flattering praise, giving it a limited relational or performative effect without undertaking a new commitment.\"\n    },\n    {\n      \"text\": \"Don’t flatter me.\",\n      \"supports\": \"The reciprocal demand for honesty frames the avowal as part of an anti-flattery stance, not as an uncontrolled exclamation or conventional romantic script.\"\n    }\n  ],\n  \"needs_more_context\": false,\n  \"context_request\": null,\n  \"typology_adequate\": true,\n  \"typology_diagnosis\": \"The truth-conditional category gives the most natural account. The utterance also has a secondary interpersonal function—reassuring the hearer while licensing frankness—but the passage supplies little evidence that it undertakes or renews a commitment. Its emotional intensification gives weak exclamatory coloring, although the clause remains clearly propositional.\",\n  \"proposed_missing_dimensions\": [],\n  \"confidence\": 0.95\n}"
