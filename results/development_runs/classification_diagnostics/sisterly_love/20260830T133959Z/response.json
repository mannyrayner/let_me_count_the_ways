          "text": "{\n  \"occurrence_id\": \"bronte-jane-eyre-b57472f62694\",\n  \"label_support\": {\n    \"truth_conditional\": 4,\n    \"performative\": 1,\n    \"exclamatory_reflexive\": 0\n  },\n  \"construals\": [\n    {\n      \"perspective\": \"speaker\",\n      \"analysis\": \"The speaker presents love as an existing attitude alongside admiration and confidence. The qualifier \\\"as a sister\\\" explicitly characterizes it as familial or sisterly rather than unqualified romantic love.\"\n    },\n    {\n      \"perspective\": \"narrator_or_text\",\n      \"analysis\": \"The text embeds the avowal in a reasoned explanation of why the speaker would have taken risks with this particular hearer, while also explaining her refusal to go to India. Its syntax is deliberative rather than spontaneous or exclamatory.\"\n    },\n    {\n      \"perspective\": \"reader\",\n      \"analysis\": \"A reader can naturally construe the statement as a sincere report of affectionate attachment and trust. It may also provide limited interpersonal reassurance, but it does not clearly undertake a new commitment.\"\n    }\n  ],\n  \"features\": [\n    \"quoted\"\n  ],\n  \"evidence\": [\n    {\n      \"text\": \"I admire, confide in, and, as a sister, I love you\",\n      \"supports\": \"The coordination of loving with \\\"admire\\\" and \\\"confide in\\\" presents all three as attitudes the speaker currently holds, strongly supporting a truth-conditional reading.\"\n    },\n    {\n      \"text\": \"as a sister\",\n      \"supports\": \"This parenthetical qualifier specifies the kind of love being avowed and limits a possible romantic construal.\"\n    },\n    {\n      \"text\": \"With you I would have ventured much\",\n      \"supports\": \"The speaker treats her attachment and trust as reasons for exceptional willingness to act with the hearer, giving the avowal some affiliative force without itself constituting a clear commitment.\"\n    },\n    {\n      \"text\": \"but I am convinced that ... I should not live long in that climate\",\n      \"supports\": \"The avowal occurs within a practical argument for not going to India, rather than as an emotionally triggered exclamation or an undertaking to go.\"\n    }\n  ],\n  \"needs_more_context\": true,\n  \"context_request\": \"The hearer's response and the preceding proposal or dispute would help determine whether the avowal is received as reassurance, rejection of a romantic interpretation, or an attempt to preserve a relationship while refusing the journey.\",\n  \"typology_adequate\": true,\n  \"typology_diagnosis\": \"The truth-conditional category gives the most natural account: the speaker avows an existing, explicitly sisterly loving attitude. Any performative effect is secondary interpersonal reassurance rather than a clear undertaking, and there is no textual support for an exclamatory/reflexive reading.\",\n  \"proposed_missing_dimensions\": [],\n  \"confidence\": 0.94\n}"
