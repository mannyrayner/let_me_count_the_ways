      {"id":"sv_perfect","regex":"\\bjag\\s+har\\s+älskat\\s+(?:dig|dej|er|eder)\\b","case_sensitive":false,"form_family":"perfect","polarity":"affirmative","tense_aspect":"perfect","syntactic_family":"main_or_embedded"},
