  "languages": {
    "en": {"name": "English", "patterns": [
      {"id":"en_negative_perfect","regex":"\\bI\\s+(?:have\\s+never|haven[’']t)\\s+loved\\s+you\\b","case_sensitive":false,"form_family":"negative_perfect","polarity":"negative","tense_aspect":"perfect","syntactic_family":"main_or_embedded"},
      {"id":"en_perfect","regex":"\\bI(?:\\s+have|[’']ve)\\s+(?:(?:always|still|really|truly)\\s+){0,2}loved\\s+you\\b","case_sensitive":false,"form_family":"perfect","polarity":"affirmative","tense_aspect":"perfect","syntactic_family":"main_or_embedded"},
      {"id":"en_cessative","regex":"\\bI\\s+(?:no\\s+longer\\s+love\\s+you|(?:do\\s+not|don[’']t)\\s+love\\s+you\\s+(?:any\\s+more|anymore))\\b","case_sensitive":false,"form_family":"cessative","polarity":"negative","tense_aspect":"present","temporal_modifier":"no_longer","syntactic_family":"main_or_embedded"},
      {"id":"en_negative_present","regex":"\\bI\\s+(?:(?:really|truly)\\s+)?(?:do\\s+not|don[’']t|never)\\s+love\\s+you\\b|\\bI\\s+love\\s+you\\s+not\\b","case_sensitive":false,"form_family":"negative_present","polarity":"negative","tense_aspect":"present","syntactic_family":"main_or_embedded"},
      {"id":"en_negative_past","regex":"\\bI\\s+(?:did\\s+not|didn[’']t|never)\\s+love(?:d)?\\s+you\\b|\\bI\\s+loved\\s+you\\s+not\\b","case_sensitive":false,"form_family":"negative_past","polarity":"negative","tense_aspect":"past","syntactic_family":"main_or_embedded"},
      {"id":"en_emphatic_present","regex":"\\bI\\s+do\\s+(?:(?:really|truly|still)\\s+){0,2}love\\s+you\\b","case_sensitive":false,"form_family":"emphatic_present","polarity":"affirmative","tense_aspect":"present","syntactic_family":"main_or_embedded"},
      {"id":"en_past","regex":"\\bI\\s+(?:did\\s+love|(?:(?:really|truly|once)\\s+){0,2}loved)\\s+you(?:\\s+once)?\\b","case_sensitive":false,"form_family":"past","polarity":"affirmative","tense_aspect":"past","temporal_modifier":"optional_once","syntactic_family":"main_or_embedded"},
      {"id":"en_future","regex":"\\bI(?:\\s+will|[’']ll)\\s+(?:(?:always|still|really|truly)\\s+){0,2}love\\s+you\\b","case_sensitive":false,"form_family":"future","polarity":"affirmative","tense_aspect":"future","syntactic_family":"main_or_embedded"},
      {"id":"en_modal","regex":"\\bI(?:\\s+(?:would|could|can)|[’']d)\\s+(?:(?:always|still|really|truly)\\s+){0,2}love\\s+you\\b","case_sensitive":false,"form_family":"modal","polarity":"affirmative","tense_aspect":"modal","modality":"explicit","syntactic_family":"main_or_embedded"},
      {"id":"en_present","regex":"\\bI\\s+(?:(?:still|really|truly|always)\\s+){0,2}love\\s+you\\b","case_sensitive":false,"form_family":"present","polarity":"affirmative","tense_aspect":"present","temporal_modifier":"optional","syntactic_family":"main_or_embedded"},
      {"id":"en_interrogative","regex":"\\b(?:why\\s+)?(?:do|don[’']t|did|didn[’']t|can|could|would|will)\\s+I\\s+(?:(?:not|still|really)\\s+)?love\\s+you\\b","case_sensitive":false,"form_family":"interrogative","polarity":"negative_or_unspecified","tense_aspect":"present","syntactic_family":"interrogative"}
