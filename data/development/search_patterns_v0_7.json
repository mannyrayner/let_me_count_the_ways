      {"id":"de_perfect","regex":"\\bich\\s+habe\\s+(?:(?:dich|Sie)\\s+(?:noch|immer|wirklich)\\s+|(?:noch|immer|wirklich)\\s+(?:dich|Sie)\\s+)?geliebt\\b","case_sensitive":false,"form_family":"perfect","polarity":"affirmative","tense_aspect":"perfect","syntactic_family":"main_or_embedded"},
