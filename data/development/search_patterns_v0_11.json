{
  "schema_version": "0.11",
  "matching": {
    "engine": "Python Unicode regular expressions",
    "default_flags": [
      "IGNORECASE"
    ],
    "normalization": "None. Match canonical Unicode text exactly as decoded; offsets are Python character offsets into that unmodified text.",
    "scope": "High-recall explicit lexical LOVE(first-person singular, second-person target) candidates; no pragmatic adjudication.",
    "controlled_fields": {
      "polarity": [
        "affirmative",
        "negative"
      ],
      "tense_aspect": [
        "present",
        "past",
        "perfect",
        "future",
        "modal"
      ],
      "syntactic_family": [
        "main_or_embedded",
        "interrogative",
        "subordinate"
      ]
    }
  },
  "languages": {
    "en": {
      "name": "English",
