          "case_sensitive": false,
          "form_family": "future",
          "polarity": "affirmative",
          "tense_aspect": "future",
          "syntactic_family": "main_or_embedded"
        },
        {
          "id": "en_modal",
          "regex": "\\bI(?:\\s+(?:would|could|can)|[’']d)\\s+(?:(?:always|still|really|truly)\\s+){0,2}love\\s+you\\b",
          "case_sensitive": false,
          "form_family": "modal",
          "polarity": "affirmative",
          "tense_aspect": "modal",
          "modality": "explicit",
          "syntactic_family": "main_or_embedded"
        },
        {
          "id": "en_present",
          "regex": "\\bI\\s+(?:(?:still|really|truly|always)\\s+){0,2}love\\s+you\\b",
          "case_sensitive": false,
          "form_family": "present",
          "polarity": "affirmative",
          "tense_aspect": "present",
          "temporal_modifier": "optional",
          "syntactic_family": "main_or_embedded"
        },
        {
          "id": "en_interrogative",
          "regex": "\\b(?:why\\s+)?(?:do|don[’']t|did|didn[’']t|can|could|would|will)\\s+I\\s+(?:(?:not|still|really)\\s+)?love\\s+you\\b",
