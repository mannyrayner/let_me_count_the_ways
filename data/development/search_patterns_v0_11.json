          "form_family": "interrogative",
          "polarity": "negative_or_unspecified",
          "tense_aspect": "present",
          "syntactic_family": "interrogative"
        },
        {
          "id": "en_emphasized_target",
          "regex": "\\bI\\s+(?:do\\s+love|did\\s+love|love|loved)\\s+_you(?:[;:,.!?])?_",
          "case_sensitive": false,
          "form_family": "emphasized_target",
          "polarity": "affirmative",
          "tense_aspect": "past",
          "syntactic_family": "main_or_embedded"
        }
      ]
